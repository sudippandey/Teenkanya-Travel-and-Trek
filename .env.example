# Supabase project API URL used by server-side enquiry handling.
SUPABASE_URL=

# Set one server-only credential. Prefer SUPABASE_SECRET_KEY; the legacy
# SUPABASE_SERVICE_ROLE_KEY is accepted as a fallback. Never expose either to clients.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side Web3Forms submission. The access key stays on the server.
WEB3FORMS_ACCESS_KEY=
# Web3Forms standard submissions route this as a CC recipient; the access key's
# primary recipient remains configured in the Web3Forms dashboard.
CONTACT_TO_EMAIL=
